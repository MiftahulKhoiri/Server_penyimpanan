# Salin ke .env lalu sesuaikan:  cp .env.example .env && chmod 600 .env
# JANGAN commit file .env ke GitHub.

# ---------- Aplikasi ----------
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ENABLE_DOCS=true
# Jumlah thread pekerja untuk disk/SQLite (Pi 3: 16 sudah cukup)
THREADPOOL_SIZE=16
# IP reverse proxy yang dipercaya (pisahkan koma). Biarkan 127.0.0.1 bila tanpa proxy.
FORWARDED_ALLOW_IPS=127.0.0.1

# ---------- Keamanan ----------
# Buat dengan: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-secret-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Akun ----------
# false = hanya admin yang bisa membuat akun (lewat /api/v1/admin/users)
ALLOW_REGISTRATION=false
PASSWORD_MIN_LENGTH=8

# ---------- Argon2 (hemat RAM Pi 3: ~19 MB per hash) ----------
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST_KIB=19456
ARGON2_PARALLELISM=1

# ---------- Pembatasan login ----------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900

# ---------- CORS ----------
# Daftar origin web yang diizinkan, pisahkan koma. Aplikasi Android native tidak butuh CORS.
CORS_ORIGINS=

# ---------- Penyimpanan ----------
PRIMARY_MOUNT_POINT=/mnt/ssd
PRIMARY_STORAGE_PATH=/mnt/ssd/storage
DATABASE_PATH=/mnt/ssd/database/server.db
BACKUP_MOUNT_POINT=/mnt/hdd
BACKUP_STORAGE_PATH=/mnt/hdd/backup
# true = tolak menulis bila SSD/HDD tidak ter-mount. Hanya false untuk pengembangan.
REQUIRE_MOUNTED_STORAGE=true

# ---------- Database ----------
AUTO_MIGRATE=true

# ---------- Batas body request JSON (endpoint non-upload), default 1 MiB ----------
MAX_REQUEST_BODY_BYTES=1048576

# ---------- Upload ----------
# Batas ukuran per file untuk upload chunked (default 64 GiB)
MAX_UPLOAD_SIZE_BYTES=68719476736
# Batas upload sekali kirim (POST /api/v1/files), default 100 MiB
MAX_SIMPLE_UPLOAD_BYTES=104857600
UPLOAD_CHUNK_SIZE_DEFAULT=8388608
UPLOAD_CHUNK_SIZE_MIN=262144
UPLOAD_CHUNK_SIZE_MAX=67108864
# Upload yang tidak disentuh selama ini dianggap kedaluwarsa dan dibersihkan
UPLOAD_EXPIRE_HOURS=24
MAX_ACTIVE_UPLOADS_PER_USER=10
# Interval pemeliharaan otomatis (detik): bersihkan upload kedaluwarsa, purge trash,
# cek jadwal backup otomatis. 0 = mati
UPLOAD_CLEANUP_INTERVAL_SECONDS=1800
# Ruang kosong minimum yang selalu disisakan di SSD (default 1 GiB)
MIN_FREE_SPACE_BYTES=1073741824
# Ekstensi tanpa titik, pisahkan koma. ALLOWED kosong = semua diizinkan.
BLOCKED_EXTENSIONS=
ALLOWED_EXTENSIONS=

# ---------- Trash ----------
TRASH_RETENTION_DAYS=30

# ---------- Backup ke HDD ----------
# 0 = backup otomatis mati (default). Backup tidak pernah menghapus file asli.
BACKUP_AUTO_INTERVAL_HOURS=0
# Jumlah salinan database di HDD yang disimpan. 0 = simpan semua (tidak ada yang dihapus).
BACKUP_DB_KEEP=0
# Ruang kosong minimum yang disisakan di HDD (default 1 GiB)
BACKUP_MIN_FREE_SPACE_BYTES=1073741824

# ---------- Media / thumbnail ----------
THUMBNAIL_ENABLED=true
THUMBNAIL_SIZE=320
THUMBNAIL_QUALITY=80
THUMBNAIL_MAX_PIXELS=80000000
# ffmpeg opsional (sudo apt install ffmpeg): thumbnail video & info durasi
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TOOL_TIMEOUT_SECONDS=30
